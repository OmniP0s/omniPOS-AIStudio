# Environment Variables
GEMINI_API_KEY=
AI_ENABLED=false
AI_MODEL_CASHIER=gemini-3.7-flash
AI_MODEL_CHAT=gemini-3.7-flash
AI_MODEL_ANALYTICS=gemini-3.7-flash
PORT=3000

# Required outside tests. Use a random value of at least 32 characters.
API_AUTH_SECRET=

# Comma-separated origins allowed to make cross-origin requests.
# Same-origin requests are always allowed; an empty list denies every cross-origin request.
CORS_ALLOWED_ORIGINS=
